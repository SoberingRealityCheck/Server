{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartOnlyThisInstance",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:us-east-2:ACCOUNT_ID:instance/INSTANCE_ID"
    },
    {
      "Sid": "ReadInstanceState",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
