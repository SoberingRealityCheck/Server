# Copy to .env and adjust. docker compose auto-loads a file named .env
# from this directory -- no extra flag needed.
#
# Every value here has a working default in docker-compose.yml, so an
# empty .env still boots. Nothing in this file is secret; it is
# gitignored mainly so your whitelist and ops list stay yours.

# --- Server identity ---
MC_MOTD=Elysium
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=8

# IANA timezone -- controls timestamps in logs.
TZ=America/Chicago

# --- Access ---
# Comma-separated Minecraft: Java Edition profile names, or UUIDs.
# OPS get operator privileges; WHITELIST controls who may join at all.
#
# IMPORTANT: these are Java profile names, NOT Xbox gamertags. The two
# differ even for the same Microsoft account, and a gamertag here will
# fail to resolve, abort startup, and leave the container restart-looping
# with "Could not resolve user from Playerdb: <name>". Players can check
# their Java profile name at
# https://www.minecraft.net/en-us/msaprofile/mygames/editprofile
#
# UUIDs are accepted and are the safer choice for anyone whose name you
# are unsure of -- they also survive the player renaming themselves.
#
# Note: the whitelist is rewritten from this value on every start, so
# in-game `/whitelist add` will not survive a restart. Edit here instead.
MC_OPS=
MC_WHITELIST=
MC_ENABLE_WHITELIST=true

# Username-to-UUID lookup service: "playerdb" (default) or "mojang".
# Switch if one is down or rate-limiting.
MC_USER_API_PROVIDER=playerdb

# --- Resource pack ---
# The pack URL and hash are generated by build.py into
# minecraft/dist/resourcepack.env -- do not set them here.
#
# Kick players who decline the download. Off by default: a declined or
# failed download would otherwise lock someone out entirely, which is
# worse than seeing untextured items.
MC_RESOURCE_PACK_ENFORCE=false

# Optional message shown in the download prompt.
MC_RESOURCE_PACK_PROMPT="This server uses a resource pack to make its added items legible. You can decline, but some items will look odd."

# --- Resources ---
# JVM heap. The container needs roughly 1 GB beyond this, so this must
# stay meaningfully below the instance's total RAM.
#   t3.medium (4 GB):  3G   -- tight for this modpack, see aws/NOTES.md
#   t3.large  (8 GB):  6G   -- recommended
MC_MEMORY=3G

# Server-side simulation/render distance in chunks. Distant Horizons
# handles long-range visuals client-side, so this can stay low.
MC_VIEW_DISTANCE=10
