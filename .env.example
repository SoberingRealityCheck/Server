# Copy this to .env and fill in real values. Never commit the real .env.
#
# .env is read by docker-compose.yml directly (docker compose auto-loads a
# file named .env in the same directory -- no extra flag needed).

# --- Database ---
DB_ROOT_PASSWORD=change_me_root
DB_PASSWORD=change_me_pterodactyl

# --- Panel ---
# The URL players/admins will hit for the dashboard. Must match the
# DNS-only (grey-cloud) or proxied Cloudflare record you point at this box.
APP_URL=https://panel.yourdomain.com
APP_TIMEZONE=UTC
LETSENCRYPT_EMAIL=you@example.com
